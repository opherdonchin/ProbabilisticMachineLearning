* text=auto

# Generated presentation artifacts are binary; regenerate them after merging
# their source instead of attempting line-by-line PDF conflict resolution.
*.pdf binary

# scripts must stay LF
*.sh text eol=lf

# vendored theme: byte-identical everywhere, no EOL rewriting
Lectures/themes/**        -text
Lectures/themes/**/*.typ  -text
# SCM syntax highlighting & preventing 3-way merges
pixi.lock merge=binary linguist-language=YAML linguist-generated=true -diff
